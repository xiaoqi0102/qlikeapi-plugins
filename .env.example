# ============================================================================
#  qlikeapi-plugins 环境变量示例
#  用法：cp .env.example .env && 填好密钥，然后把 .env 一起交给 docker compose
#  生成随机密钥：openssl rand -hex 24
# ============================================================================

# ---- 必填：安全相关 ----------------------------------------------------------
# 内部主密钥。New API 里那个「渠道密钥」填的就是它；也是 /v1/* 统一入口的凭据之一。
QLIKEAPI_UP_TOKEN=

# 会话 Cookie 签名 + 落库密钥加密的派生源。换掉它＝已存的渠道密钥解不开（需重填）。
QLIKEAPI_SECRET=

# 控制台登录账号（首次启动写入 SQLite；之后改这里无效，用控制台「修改密码」）
QLIKEAPI_ADMIN_USER=admin
# 控制台登录密码。留空＝首次启动随机生成并打印在容器日志里。
QLIKEAPI_ADMIN_PASS=

# 落库密钥的独立加密密钥（不填则回退用 QLIKEAPI_SECRET 派生）
# QLIKEAPI_ENC_KEY=

# ---- 选填：网络与超时 --------------------------------------------------------
# 数据库文件位置（容器内路径，配合 ./data 卷）
QLIKEAPI_DB=/data/qlikeapi.db

# HTTPS 反代下保持 1（Cookie 加 Secure）；纯 http 内网调试设 0
QLIKEAPI_SECURE_COOKIE=1

# 单次上游请求最长等待（秒）
QLIKEAPI_TIMEOUT=900
# 异步面（队列类渠道）轮询间隔与最长轮询时间（秒）
QLIKEAPI_POLL_INTERVAL=3
QLIKEAPI_POLL_MAX=600
# 探活（零成本自检）硬超时（秒）——必须保留，否则挂起的上游会把探活卡死
QLIKEAPI_PROBE_TIMEOUT=12

# ---- 选填：熔断与自动恢复 ----------------------------------------------------
# 连续失败多少次自动停用该渠道
QLIKEAPI_AUTO_DISABLE_AFTER=5
# 熔断后最短冷却时间（秒），到点后仍需「探活通过」才真正恢复
QLIKEAPI_AUTO_RECOVER_SEC=600

# ---- 选填：控制台增强 --------------------------------------------------------
# 只读挂载的宿主机 .env 路径：控制台「从 .env 导入站点」会读它（可留空）
# QLIKEAPI_IMPORT_ENV=/env/hermes.env

# ---- 站点余额取数用的凭据（按需填写，非本程序必需）--------------------------
# change2pro（sub2api 系）余额查询：GET https://api.change2pro.com/v1/usage
# 也可在控制台「站点余额」里直接填，不必写进 .env
# CHANGE2PRO_TOKEN=
